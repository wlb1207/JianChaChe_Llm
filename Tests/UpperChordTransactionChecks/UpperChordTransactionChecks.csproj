<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget><NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <Target Name="RequireExplicitApplicationOutput" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(ApplicationOutputDirectory)' == '' or !Exists('$(ApplicationOutputDirectory)\LlmWpfPrototype.dll')" Text="Set ApplicationOutputDirectory to the independent current application build directory."/>
  </Target>
  <ItemGroup>
    <Reference Include="LlmWpfPrototype"><HintPath>$(ApplicationOutputDirectory)\LlmWpfPrototype.dll</HintPath></Reference>
    <Content Include="$(ApplicationOutputDirectory)\Config\*.json" Link="Config/%(Filename)%(Extension)" CopyToOutputDirectory="Always"/>
  </ItemGroup>
</Project>