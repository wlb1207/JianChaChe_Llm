<Window x:Class="LlmWpfPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:LlmWpfPrototype.Models"
        mc:Ignorable="d"
        Title="&#x6865;&#x6881;&#x68C0;&#x67E5;&#x8F66;&#x667A;&#x80FD;&#x8BBE;&#x8BA1;&#x52A9;&#x624B;"
        Height="920"
        Width="1440"
        MinHeight="780"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F7FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,12"
                Background="White"
                BorderBrush="#FFD8E0EA"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock FontSize="26"
                           FontWeight="Bold"
                           Text="&#x6865;&#x6881;&#x68C0;&#x67E5;&#x8F66;&#x667A;&#x80FD;&#x8BBE;&#x8BA1;&#x52A9;&#x624B;" />

                <Border Grid.Column="1"
                        Padding="12,8"
                        Background="#FFF8FAFC"
                        BorderBrush="#FFD8E0EA"
                        BorderThickness="1"
                        CornerRadius="10"
                        HorizontalAlignment="Right">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding GptStatusSummary}" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,16"
                Background="White"
                BorderBrush="#FFD8E0EA"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="16,14,16,10">
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="&#x5BF9;&#x8BDD;&#x533A;" />
                </DockPanel>

                <ScrollViewer x:Name="ChatScrollViewer"
                              Grid.Row="1"
                              Margin="16,0,16,16"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="ChatScrollViewer_ScrollChanged">
                    <ItemsControl x:Name="ChatItemsControl"
                                  ItemsSource="{Binding ChatMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ChatMessage}">
                                <Border x:Name="Bubble"
                                        Margin="0,0,0,12"
                                        Padding="14,10"
                                        Background="#FFF8FAFC"
                                        BorderBrush="#FFD8E0EA"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        HorizontalAlignment="Left"
                                        MaxWidth="760">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="#FF334155"
                                                       Text="{Binding RoleDisplay}" />
                                            <TextBlock Margin="10,0,0,0"
                                                       Foreground="#FF94A3B8"
                                                       Text="{Binding TimeDisplay}" />
                                        </DockPanel>
                                        <TextBox Margin="0,8,0,0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 IsReadOnly="True"
                                                 Foreground="#FF0F172A"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding Text}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Bubble" Property="Background" Value="#FFE0F2FE" />
                                        <Setter TargetName="Bubble" Property="BorderBrush" Value="#FF7DD3FC" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="14"
                Background="White"
                BorderBrush="#FFD8E0EA"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Grid MinHeight="88">
                        <TextBox x:Name="UserInputTextBox"
                                 Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="False"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="88"
                                 Padding="12"
                                 FontSize="14"
                                 Background="Transparent" />
                        <TextBlock Margin="16,12,40,12"
                                   Foreground="#FF94A3B8"
                                   FontSize="14"
                                   IsHitTestVisible="False"
                                   Text="&#x5728;&#x8FD9;&#x91CC;&#x8F93;&#x5165;&#x6D88;&#x606F;&#xFF0C;&#x6309; Enter &#x53D1;&#x9001;"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text.IsEmpty, ElementName=UserInputTextBox}" Value="True" />
                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=UserInputTextBox}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Width="110"
                                Height="36"
                                Content="&#x6E05;&#x7A7A;&#x5BF9;&#x8BDD;"
                                Command="{Binding ClearConversationCommand}" />
                        <Button Width="110"
                                Height="36"
                                Margin="10,0,0,0"
                                Content="&#x91CD;&#x65B0;&#x89E3;&#x6790;"
                                Command="{Binding ReparseCommand}" />
                        <Button Width="120"
                                Height="36"
                                Margin="10,0,0,0"
                                Content="{Binding AdvancedDebugButtonText}"
                                Command="{Binding ToggleAdvancedDebugCommand}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Width="220"
                        Height="52"
                        Margin="16,0,0,0"
                        VerticalAlignment="Bottom"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        Content="{Binding PrimaryActionText}"
                        Command="{Binding PrimaryActionCommand}" />
            </Grid>
        </Border>

        <Expander Grid.Row="3"
                  Margin="0,16,0,0"
                  IsExpanded="{Binding IsAdvancedDebugExpanded, Mode=TwoWay}"
                  Header="&#x9AD8;&#x7EA7;&#x8C03;&#x8BD5;">
            <Border Padding="12"
                    Background="White"
                    BorderBrush="#FFD8E0EA"
                    BorderThickness="1"
                    CornerRadius="0,0,12,12">
                <TabControl x:Name="AdvancedDebugTabControl"
                            MinHeight="260">
                    <TabItem Header="JSON &#x7ED3;&#x679C;">
                        <TextBox Text="{Binding JsonOutput, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Padding="12" />
                    </TabItem>
                    <TabItem Header="&#x53C2;&#x6570;&#x8868;">
                        <DataGrid ItemsSource="{Binding Parameters}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="&#x53C2;&#x6570;&#x540D;" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="&#x663E;&#x793A;&#x540D;" Binding="{Binding DisplayName}" Width="2*" />
                                <DataGridTextColumn Header="&#x6570;&#x503C;" Binding="{Binding Value}" Width="*" />
                                <DataGridTextColumn Header="&#x5355;&#x4F4D;" Binding="{Binding Unit}" Width="*" />
                                <DataGridTextColumn Header="&#x6620;&#x5C04;&#x72B6;&#x6001;" Binding="{Binding MappingStatus}" Width="1.4*" />
                                <DataGridTextColumn Header="&#x8BF4;&#x660E;" Binding="{Binding Description}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="APDL &#x9884;&#x89C8;">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top"
                                        Orientation="Horizontal"
                                        Margin="12">
                                <Button Width="160"
                                        Height="34"
                                        Content="&#x751F;&#x6210; APDL &#x8C03;&#x8BD5;&#x6587;&#x4EF6;"
                                        Command="{Binding GenerateApdlCommand}" />
                                <Button Width="140"
                                        Height="34"
                                        Margin="10,0,0,0"
                                        Content="&#x6253;&#x5F00;&#x8F93;&#x51FA;&#x6587;&#x4EF6;"
                                        Command="{Binding OpenApdlOutputFileCommand}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="12,0,12,8"
                                       Text="{Binding ApdlOutputPath}" />
                            <TextBox Margin="12"
                                     Text="{Binding ApdlPreviewContent, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Padding="12" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="&#x65E5;&#x5FD7;&#x8F93;&#x51FA;">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0"
                                       Margin="0,0,0,12"
                                       LastChildFill="False">
                                <CheckBox x:Name="LogAutoScrollCheckBox"
                                          Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsLogAutoScrollEnabled, Mode=TwoWay}"
                                          Checked="LogAutoScrollCheckBox_Checked"
                                          Content="&#x81EA;&#x52A8;&#x6EDA;&#x52A8;&#x5230;&#x5E95;&#x90E8;" />
                                <Button Width="100"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        Content="&#x6EDA;&#x52A8;&#x5230;&#x5E95;&#x90E8;"
                                        Click="ScrollLogToBottomButton_Click" />
                                <Button Width="100"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        Content="&#x6E05;&#x7A7A;&#x663E;&#x793A;"
                                        Command="{Binding ClearLogsCommand}" />
                                <Button Width="100"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        Content="&#x590D;&#x5236;&#x5F53;&#x524D;&#x65E5;&#x5FD7;"
                                        Command="{Binding CopyCurrentLogsCommand}" />
                                <Button Width="120"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        Content="&#x6D4B;&#x8BD5; LLM &#x8FDE;&#x63A5;"
                                        Command="{Binding TestLlmConnectionCommand}" />
                                <Button Width="100"
                                        Height="32"
                                        Content="&#x5BFC;&#x51FA;&#x65E5;&#x5FD7;"
                                        Command="{Binding ExportLogsCommand}" />
                            </DockPanel>

                            <TextBox x:Name="LogTextBox"
                                     Grid.Row="1"
                                     Text="{Binding Logs, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Padding="12"
                                     TextChanged="LogTextBox_TextChanged" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Expander>
    </Grid>
</Window>
