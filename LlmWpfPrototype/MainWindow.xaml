<Window x:Class="LlmWpfPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:LlmWpfPrototype.Models"
        xmlns:ui="clr-namespace:LlmWpfPrototype.Presentation"
        xmlns:vm="clr-namespace:LlmWpfPrototype.ViewModels"
        mc:Ignorable="d"
        Title="桥梁检查车智能设计助手"
        Height="920"
        Width="1440"
        MinHeight="600"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        Background="#FFF4F6F9">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SidebarIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="#FFE2E8F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="#FFCBD5E1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectTitleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleBorder" Property="Background" Value="#FFF8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConversationItemButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Margin="0,1.5"
                                Padding="9,6.5"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFF1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BubbleCopyButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF64748B" />
        </Style>

        <Style x:Key="ScenarioTaskCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFE2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#FFF0F9FF" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF38BDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#FFE0F2FE" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF0284C7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="288" MinWidth="236" MaxWidth="400" />
            <ColumnDefinition x:Name="SplitterColumn" Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧：项目管理与多次跟进会话侧边栏 ==================== -->
        <Border Grid.Column="0"
                Background="#FFFAF9F6"
                BorderBrush="#FFE2E8F0"
                BorderThickness="1"
                CornerRadius="14"
                Visibility="{Binding IsProjectSidebarVisible, Converter={StaticResource BoolToVis}}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1. 顶部：项目管理 ›   [筛选] [新建项目文件夹+] -->
                <Grid Grid.Row="0" Margin="4,2,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="项目管理"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FF475569" />
                        <TextBlock Text=" ›"
                                   FontSize="15.5"
                                   Margin="3,-1,0,0"
                                   Foreground="#FF94A3B8" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="30"
                            Height="30"
                            Margin="0,0,4,0"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            ToolTip="筛选或搜索设计项目"
                            Command="{Binding ToggleProjectFilterCommand}">
                        <Path Data="M2.5,4.5 H15.5 M5.5,9 H12.5 M8,13.5 H10"
                              Stroke="#FF64748B"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>

                    <Button Grid.Column="2"
                            Width="30"
                            Height="30"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            ToolTip="新建设计项目（0秒创建，按需隔离三维模型副本）"
                            Command="{Binding CreateProjectCommand}">
                        <Canvas Width="18" Height="18">
                            <Path Data="M1.5,4.5 C1.5,3.7 2.2,3 3,3 H6.8 L8.5,4.8 H14.8 C15.6,4.8 16.3,5.5 16.3,6.3 V9.2 M1.5,6.2 V14 C1.5,14.8 2.2,15.5 3,15.5 H9.8"
                                  Stroke="#FF64748B"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Path Data="M13.8,10.8 V15.8 M11.3,13.3 H16.3"
                                  Stroke="#FF64748B"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Button>
                </Grid>

                <!-- 2. 搜索筛选 / 项目重命名 / 历史版本（默认全折叠，按需展开） -->
                <StackPanel Grid.Row="1">
                    <Border Margin="0,0,0,10"
                            Padding="9"
                            Background="White"
                            BorderBrush="#FFE2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding IsProjectFilterExpanded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <TextBox x:Name="ProjectSearchBox"
                                         Height="30"
                                         Padding="8,4"
                                         FontSize="12.5"
                                         Text="{Binding ProjectSearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="10,0,8,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="#FF94A3B8"
                                           IsHitTestVisible="False"
                                           Text="搜索项目名、规格或对话...">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.IsEmpty, ElementName=ProjectSearchBox}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                                <RadioButton Content="进行中"
                                             FontSize="12"
                                             Margin="0,0,12,0"
                                             IsChecked="{Binding IsFilterActive, Mode=OneWay}"
                                             Command="{Binding SetProjectFilterModeCommand}"
                                             CommandParameter="Active" />
                                <RadioButton Content="全部"
                                             FontSize="12"
                                             Margin="0,0,12,0"
                                             IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                             Command="{Binding SetProjectFilterModeCommand}"
                                             CommandParameter="All" />
                                <RadioButton Content="已归档"
                                             FontSize="12"
                                             IsChecked="{Binding IsFilterArchived, Mode=OneWay}"
                                             Command="{Binding SetProjectFilterModeCommand}"
                                             CommandParameter="Archived" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,10"
                            Padding="10"
                            Background="White"
                            BorderBrush="#FF7DD3FC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding IsEditingProjectMeta, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF0369A1" Text="编辑项目名称与设计目标" />
                            <TextBox Margin="0,7,0,0"
                                     Height="30"
                                     Padding="8,4"
                                     FontSize="12.5"
                                     Text="{Binding EditingProjectName, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="ProjectMetaTextBox_KeyDown"
                                     ToolTip="项目名称（按回车保存，Esc 取消）" />
                            <TextBox Margin="0,7,0,0"
                                     MinHeight="48"
                                     MaxHeight="80"
                                     Padding="8,6"
                                     FontSize="12"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     TextWrapping="Wrap"
                                     Text="{Binding EditingProjectGoal, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="项目长期设计目标与约束备注" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Height="28" Padding="12,0" FontSize="12" Style="{StaticResource PrimaryButtonStyle}" Content="保存" Command="{Binding SaveProjectMetaCommand}" />
                                <Button Height="28" Padding="10,0" Margin="6,0,0,0" FontSize="12" Content="取消" Command="{Binding CancelEditProjectMetaCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,10"
                            Padding="10"
                            Background="White"
                            BorderBrush="#FFE2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding IsVersionPanelExpanded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <Button DockPanel.Dock="Right" Padding="7,2" FontSize="11.5" Style="{StaticResource GhostButtonStyle}" Content="收起"
                                        Command="{Binding ToggleVersionPanelCommand}" />
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF334155" VerticalAlignment="Center" Text="历史版本记录" />
                            </DockPanel>
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ActiveVersionHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:DesignVersionCheckpoint}">
                                            <DockPanel Margin="0,0,0,5">
                                                <Button DockPanel.Dock="Right" Padding="8,2" FontSize="11" Content="回退"
                                                        Command="{Binding DataContext.RollbackToVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock FontSize="11.5" Foreground="#FF475569" VerticalAlignment="Center" Margin="0,0,6,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SpecsOverviewText}">
                                                    <Run FontWeight="Bold" Foreground="#FF0284C7" Text="{Binding VersionTag, Mode=OneWay}" />
                                                    <Run Text="{Binding Summary, StringFormat=' {0}', Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. 项目与多次对话列表（支持空项目状态，彻底移除底部常驻 SW 卡片） -->
                <Grid Grid.Row="2">
                    <ScrollViewer Focusable="False"
                                  FocusVisualStyle="{x:Null}"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DesignProjectItemViewModel}">
                                <Border x:Name="ProjectCard"
                                        Margin="0,0,0,9"
                                        Padding="9,9"
                                        Background="White"
                                        BorderBrush="#FFE2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="编辑项目名称与设计目标"
                                                      Command="{Binding PlacementTarget.Tag.BeginEditProjectMetaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="查看历史版本 / 回退"
                                                      Command="{Binding PlacementTarget.Tag.ToggleVersionPanelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="打开本项目三维模型"
                                                      Command="{Binding PlacementTarget.Tag.OpenProjectModelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="同步 SolidWorks 实测尺寸"
                                                      Command="{Binding PlacementTarget.Tag.SyncLiveDimensionsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="基于此项目派生新方案 (Fork)"
                                                      Command="{Binding PlacementTarget.Tag.ForkProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{Binding PinActionText}"
                                                      Command="{Binding PlacementTarget.Tag.TogglePinProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="导出项目设计及实验报告 (.md)"
                                                      Command="{Binding PlacementTarget.Tag.ExportProjectReportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="{Binding ArchiveActionText}"
                                                      Command="{Binding PlacementTarget.Tag.ToggleArchiveProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="删除项目"
                                                      Foreground="#FFDC2626"
                                                      Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="DeleteProjectMenuItem_Click" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 折叠/展开小箭头 -->
                                            <Button Grid.Column="0"
                                                    Width="22"
                                                    Height="24"
                                                    Margin="0,1,2,0"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource SidebarIconButtonStyle}"
                                                    ToolTip="折叠或展开此项目的对话列表"
                                                    Command="{Binding DataContext.ToggleProjectExpandedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding ExpandChevronText}"
                                                           FontSize="11.5"
                                                           Foreground="#FF64748B" />
                                            </Button>

                                            <!-- 项目名称与版本摘要 -->
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource ProjectTitleButtonStyle}"
                                                    Command="{Binding DataContext.SelectProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FF0F172A"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding VersionBadgeText}"
                                                               Margin="0,2.5,0,0"
                                                               FontSize="11.5"
                                                               Foreground="#FF0284C7"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>

                                            <!-- 新建此项目对话（简洁 + 图标） -->
                                            <Button Grid.Column="2"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="2,0,2,0"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource SidebarIconButtonStyle}"
                                                    ToolTip="在此项目下新建一次跟进对话"
                                                    Command="{Binding DataContext.CreateConversationInProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="M9,4 V14 M4,9 H14"
                                                      Width="14"
                                                      Height="14"
                                                      Stretch="Uniform"
                                                      Stroke="#FF64748B"
                                                      StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Button>

                                            <!-- 更多菜单 -->
                                            <Button Grid.Column="3"
                                                    Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource SidebarIconButtonStyle}"
                                                    ToolTip="项目操作菜单（编辑目标 / 版本回退 / 派生方案 / 导出报告）"
                                                    Click="ProjectMoreButton_Click">
                                                <TextBlock Text="⋯" FontWeight="Bold" Foreground="#FF64748B" Margin="0,-3,0,0" />
                                            </Button>
                                        </Grid>

                                        <!-- 项目内多次对话列表（支持单个项目折叠） -->
                                        <ItemsControl Margin="18,6,0,0"
                                                      ItemsSource="{Binding Conversations}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:DesignConversationItemViewModel}">
                                                    <Button x:Name="ConvItemButton"
                                                            Style="{StaticResource ConversationItemButtonStyle}"
                                                            Command="{Binding DataContext.SelectConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="删除此条对话"
                                                                          Foreground="#FFDC2626"
                                                                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          Click="DeleteConversationMenuItem_Click" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Margin="6,0,0,0"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#FF94A3B8"
                                                                       Text="{Binding UpdatedTimeShort}" />
                                                            <TextBlock x:Name="ConvTitle"
                                                                       FontSize="12.5"
                                                                       Foreground="#FF475569"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding Title}" />
                                                        </DockPanel>
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="ConvItemButton" Property="Background" Value="#FFF1F5F9" />
                                                            <Setter TargetName="ConvTitle" Property="Foreground" Value="#FF0369A1" />
                                                            <Setter TargetName="ConvTitle" Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="ProjectCard" Property="BorderBrush" Value="#FF7DD3FC" />
                                        <Setter TargetName="ProjectCard" Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <!-- 无项目或搜索无结果时的简洁引导空态 -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="16,0"
                                Visibility="{Binding ShowEmptyProjectsState, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding EmptyProjectsHintText}"
                                   FontSize="12.5"
                                   Foreground="#FF94A3B8"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="20" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 可拖拽侧边栏宽度分隔条 -->
        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="True"
                      Visibility="{Binding IsProjectSidebarVisible, Converter={StaticResource BoolToVis}}" />

        <!-- ==================== 右侧：主设计工作区 ==================== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 精简标题栏 -->
                <RowDefinition Height="*" />    <!-- 对话区 -->
                <RowDefinition Height="Auto" /> <!-- 处理中提示 / 待确认快捷条 -->
                <RowDefinition Height="Auto" /> <!-- 一体式输入区 -->
                <RowDefinition Height="Auto" /> <!-- 高级调试 -->
            </Grid.RowDefinitions>

            <!-- Row 0：精简主标题栏 -->
            <Border Grid.Row="0"
                    Padding="12,9"
                    Background="White"
                    BorderBrush="#FFE2E8F0"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Width="32"
                            Height="32"
                            Margin="0,0,10,0"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            ToolTip="{Binding ToggleSidebarTooltip}"
                            Command="{Binding ToggleSidebarCommand}">
                        <Canvas Width="18" Height="18">
                            <Rectangle Canvas.Left="1.5" Canvas.Top="2.5" Width="15" Height="13" RadiusX="2.5" RadiusY="2.5"
                                       Stroke="#FF334155" StrokeThickness="1.5" />
                            <Line X1="6.8" Y1="2.5" X2="6.8" Y2="15.5" Stroke="#FF334155" StrokeThickness="1.5" />
                        </Canvas>
                    </Button>

                    <TextBlock Grid.Column="1"
                               FontSize="17.5"
                               FontWeight="Bold"
                               Foreground="#FF0F172A"
                               VerticalAlignment="Center"
                               Text="桥梁检查车智能设计助手" />

                    <!-- AI 连通状态胶囊（四态颜色 + 连接中呼吸过渡 + 点击一键重连） -->
                    <Button Grid.Column="2"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            VerticalAlignment="Center"
                            Command="{Binding ReconnectLlmCommand}"
                            ToolTip="{Binding LlmStatusTooltip}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="StatusPillBorder"
                                        Padding="11,5.5"
                                        Background="#FFF8FAFC"
                                        BorderBrush="#FFE2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="LlmStatusDot"
                                                 Width="8"
                                                 Height="8"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 Fill="#FF94A3B8" />
                                        <TextBlock x:Name="LlmStatusText"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FF334155"
                                                   Text="{Binding GptStatusSummary}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLlmStatusConnecting}" Value="True">
                                        <Setter TargetName="StatusPillBorder" Property="Background" Value="#FFFFFBEB" />
                                        <Setter TargetName="StatusPillBorder" Property="BorderBrush" Value="#FFFDE68A" />
                                        <Setter TargetName="LlmStatusDot" Property="Fill" Value="#FFF59E0B" />
                                        <Setter TargetName="LlmStatusText" Property="Foreground" Value="#FF92400E" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="ConnectingPulseStoryboard">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetName="LlmStatusDot"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     From="1.0"
                                                                     To="0.25"
                                                                     Duration="0:0:0.7" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="ConnectingPulseStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLlmStatusOnline}" Value="True">
                                        <Setter TargetName="StatusPillBorder" Property="Background" Value="#FFF0FDF4" />
                                        <Setter TargetName="StatusPillBorder" Property="BorderBrush" Value="#FFBBF7D0" />
                                        <Setter TargetName="LlmStatusDot" Property="Fill" Value="#FF16A34A" />
                                        <Setter TargetName="LlmStatusDot" Property="Opacity" Value="1.0" />
                                        <Setter TargetName="LlmStatusText" Property="Foreground" Value="#FF166534" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLlmStatusError}" Value="True">
                                        <Setter TargetName="StatusPillBorder" Property="Background" Value="#FFFEF2F2" />
                                        <Setter TargetName="StatusPillBorder" Property="BorderBrush" Value="#FFFECACA" />
                                        <Setter TargetName="LlmStatusDot" Property="Fill" Value="#FFDC2626" />
                                        <Setter TargetName="LlmStatusDot" Property="Opacity" Value="1.0" />
                                        <Setter TargetName="LlmStatusText" Property="Foreground" Value="#FF991B1B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLlmStatusMock}" Value="True">
                                        <Setter TargetName="StatusPillBorder" Property="Background" Value="#FFF8FAFC" />
                                        <Setter TargetName="StatusPillBorder" Property="BorderBrush" Value="#FFE2E8F0" />
                                        <Setter TargetName="LlmStatusDot" Property="Fill" Value="#FF64748B" />
                                        <Setter TargetName="LlmStatusText" Property="Foreground" Value="#FF475569" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="StatusPillBorder" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Row 1：对话区（有项目时显示对话流；0 项目时显示方案 1A 居中引导空态） -->
            <Grid Grid.Row="1" Margin="0,10,0,10">
                <!-- 方案 1A：零项目空态工作台（无假气泡、无输入框） -->
                <Border Background="White"
                        BorderBrush="#FFE2E8F0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Visibility="{Binding HasZeroProjects, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="460"
                                Margin="24">
                        <Border Width="54"
                                Height="54"
                                Background="#FFF0F9FF"
                                BorderBrush="#FFBAE6FD"
                                BorderThickness="1"
                                CornerRadius="16"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,18">
                            <Canvas Width="26" Height="26">
                                <Path Data="M2.5,7 C2.5,5.6 3.6,4.5 5,4.5 H10.2 L12.5,7 H21 C22.4,7 23.5,8.1 23.5,9.5 V19 C23.5,20.4 22.4,21.5 21,21.5 H5 C3.6,21.5 2.5,20.4 2.5,19 Z"
                                      Stroke="#FF0284C7"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Path Data="M13,11 V17 M10,14 H16"
                                      Stroke="#FF0284C7"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Border>

                        <TextBlock Text="开始一个新的结构设计项目"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#FF0F172A"
                                   HorizontalAlignment="Center" />

                        <TextBlock Margin="0,10,0,22"
                                   Text="当前暂无活动项目。新建项目后即可开展多轮持续对话、参数化改型、截面力学评估与仿真协同。"
                                   FontSize="13.5"
                                   Foreground="#FF64748B"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="22" />

                        <Button Height="40"
                                Padding="24,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="+ 新建设计项目"
                                Command="{Binding CreateProjectCommand}" />

                        <TextBlock Margin="0,20,0,0"
                                   Text="多轮持续设计  ·  SolidWorks 联动  ·  ANSYS APDL 协同  ·  规范检索"
                                   FontSize="11.5"
                                   Foreground="#FF94A3B8"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 有活动项目时：正常对话区 -->
                <Border Background="White"
                        BorderBrush="#FFE2E8F0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Visibility="{Binding HasActiveProject, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="16,10"
                            BorderBrush="#FFF1F5F9"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Height="29"
                                    Padding="12,0"
                                    FontSize="12"
                                    Content="+ 新建跟进对话"
                                    ToolTip="在当前项目下开启新对话，保留旧对话并共享当前模型快照"
                                    Command="{Binding CreateNewConversationCommand}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="14.5"
                                           FontWeight="SemiBold"
                                           Foreground="#FF334155"
                                           VerticalAlignment="Center"
                                           Text="设计对话" />
                                <TextBlock Margin="10,0,0,0"
                                           FontSize="12"
                                           Foreground="#FF94A3B8"
                                           VerticalAlignment="Center"
                                           Text="{Binding ActiveProjectDisplayName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProjectSidebarVisible}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer x:Name="ChatScrollViewer"
                                  Grid.Row="1"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}"
                                  Padding="18,14,18,14"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="ChatScrollViewer_ScrollChanged">
                        <StackPanel>
                            <!-- 方案 A：新对话开屏「本车智能设计简报卡 + 2×2 场景化工程任务卡」（发送首条消息后自动切换为对话流） -->
                            <StackPanel Visibility="{Binding ShowWelcomeDashboard, Converter={StaticResource BoolToVis}}"
                                        MaxWidth="980"
                                        HorizontalAlignment="Stretch"
                                        Margin="2,4,2,8">
                                <!-- 1. 本车智能设计简报主卡片 -->
                                <Border CornerRadius="13"
                                        BorderBrush="#FFBAE6FD"
                                        BorderThickness="1"
                                        Padding="20,18">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFF0F9FF" Offset="0" />
                                            <GradientStop Color="#FFFFFFFF" Offset="0.55" />
                                            <GradientStop Color="#FFF8FAFC" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <!-- 顶部标题 + 引擎就绪徽章 -->
                                        <DockPanel LastChildFill="True">
                                            <WrapPanel DockPanel.Dock="Right"
                                                       VerticalAlignment="Top"
                                                       HorizontalAlignment="Right"
                                                       Margin="12,0,0,0">
                                                <!-- 三规范知识库就绪徽章 -->
                                                <Border Margin="0,0,6,6"
                                                        Padding="9,4"
                                                        CornerRadius="12"
                                                        Background="#FFECFDF5"
                                                        BorderBrush="#FFA7F3D0"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="6.5" Height="6.5" Fill="#FF059669" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock FontSize="11.5"
                                                                   FontWeight="Medium"
                                                                   Foreground="#FF047857"
                                                                   Text="{Binding WelcomeDashboard.KbStatusText}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- SolidWorks 状态徽章 -->
                                                <Border Margin="0,0,6,6"
                                                        Padding="9,4"
                                                        CornerRadius="12"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FFF1F5F9" />
                                                            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding WelcomeDashboard.IsSolidWorksOpened}" Value="True">
                                                                    <Setter Property="Background" Value="#FFE0F2FE" />
                                                                    <Setter Property="BorderBrush" Value="#FF7DD3FC" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="6.5" Height="6.5" Margin="0,0,5,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#FF64748B" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding WelcomeDashboard.IsSolidWorksOpened}" Value="True">
                                                                            <Setter Property="Fill" Value="#FF0284C7" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock FontSize="11.5"
                                                                   FontWeight="Medium"
                                                                   Foreground="#FF334155"
                                                                   Text="{Binding WelcomeDashboard.SolidWorksStatusText}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- ANSYS APDL 状态徽章 -->
                                                <Border Margin="0,0,0,6"
                                                        Padding="9,4"
                                                        CornerRadius="12"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FFF8FAFC" />
                                                            <Setter Property="BorderBrush" Value="#FFE2E8F0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding WelcomeDashboard.IsApdlReady}" Value="True">
                                                                    <Setter Property="Background" Value="#FFECFDF5" />
                                                                    <Setter Property="BorderBrush" Value="#FFA7F3D0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="6.5" Height="6.5" Margin="0,0,5,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#FF94A3B8" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding WelcomeDashboard.IsApdlReady}" Value="True">
                                                                            <Setter Property="Fill" Value="#FF059669" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock FontSize="11.5"
                                                                   FontWeight="Medium"
                                                                   Foreground="#FF334155"
                                                                   Text="{Binding WelcomeDashboard.ApdlStatusText}" />
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>

                                            <StackPanel>
                                                <WrapPanel VerticalAlignment="Center">
                                                    <Border Padding="8,2.5"
                                                            Margin="0,0,8,4"
                                                            CornerRadius="6"
                                                            Background="#FF0284C7">
                                                        <TextBlock FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   Text="{Binding WelcomeDashboard.ModelCodeBadge}" />
                                                    </Border>
                                                    <TextBlock FontSize="17"
                                                               FontWeight="Bold"
                                                               Foreground="#FF0F172A"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,4"
                                                               Text="{Binding WelcomeDashboard.ProjectName}" />
                                                    <Border Padding="7,2"
                                                            Margin="0,0,0,4"
                                                            CornerRadius="6"
                                                            Background="#FFE0F2FE"
                                                            BorderBrush="#FF7DD3FC"
                                                            BorderThickness="1">
                                                        <TextBlock FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FF0369A1"
                                                                   Text="{Binding WelcomeDashboard.VersionTag}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="12.5"
                                                           Foreground="#FF475569"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding WelcomeDashboard.VehicleSubtitle}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- 迭代/跟进衔接提示（仅 V1+ 或跟进对话展示） -->
                                        <Border Margin="0,10,0,0"
                                                Padding="11,7"
                                                CornerRadius="8"
                                                Background="#FFEFF6FF"
                                                BorderBrush="#FFBFDBFE"
                                                BorderThickness="1"
                                                Visibility="{Binding WelcomeDashboard.HasFollowUpNote, Converter={StaticResource BoolToVis}}">
                                            <TextBlock FontSize="12"
                                                       Foreground="#FF1D4ED8"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding WelcomeDashboard.FollowUpNote}" />
                                        </Border>

                                        <!-- 中部：上/下弦杆实时截面与规范体检双卡 -->
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 上弦杆实时卡 -->
                                            <Border Grid.Column="0"
                                                    Background="White"
                                                    BorderBrush="#FFE2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="14,11">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right"
                                                                Padding="7,2"
                                                                CornerRadius="10"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#FFECFDF5" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding WelcomeDashboard.UpperChord.HasWarning}" Value="True">
                                                                            <Setter Property="Background" Value="#FFFEF3C7" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding WelcomeDashboard.UpperChord.StatusBadgeText}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#FF047857" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding WelcomeDashboard.UpperChord.HasWarning}" Value="True">
                                                                                <Setter Property="Foreground" Value="#FFB45309" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FF475569"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding WelcomeDashboard.UpperChord.RoleTitle}" />
                                                    </DockPanel>
                                                    <TextBlock Margin="0,6,0,4"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="#FF0F172A"
                                                               Text="{Binding WelcomeDashboard.UpperChord.SpecText}" />
                                                    <TextBlock FontSize="11.5"
                                                               Foreground="#FF475569"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding WelcomeDashboard.UpperChord.Line1}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="11.5"
                                                               Foreground="#FF64748B"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding WelcomeDashboard.UpperChord.Line2}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- 下弦杆实时卡 -->
                                            <Border Grid.Column="2"
                                                    Background="White"
                                                    BorderBrush="#FFE2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="14,11">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right"
                                                                Padding="7,2"
                                                                CornerRadius="10"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#FFECFDF5" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding WelcomeDashboard.LowerChord.HasWarning}" Value="True">
                                                                            <Setter Property="Background" Value="#FFFEF3C7" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding WelcomeDashboard.LowerChord.StatusBadgeText}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#FF047857" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding WelcomeDashboard.LowerChord.HasWarning}" Value="True">
                                                                                <Setter Property="Foreground" Value="#FFB45309" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FF475569"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding WelcomeDashboard.LowerChord.RoleTitle}" />
                                                    </DockPanel>
                                                    <TextBlock Margin="0,6,0,4"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="#FF0F172A"
                                                               Text="{Binding WelcomeDashboard.LowerChord.SpecText}" />
                                                    <TextBlock FontSize="11.5"
                                                               Foreground="#FF475569"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding WelcomeDashboard.LowerChord.Line1}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="11.5"
                                                               Foreground="#FF64748B"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding WelcomeDashboard.LowerChord.Line2}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- 底部：绑定本车的三规范核心控制红线条 -->
                                        <Border Margin="0,12,0,0"
                                                Padding="12,8"
                                                CornerRadius="9"
                                                Background="#FFF8FAFC"
                                                BorderBrush="#FFE2E8F0"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left"
                                                           Margin="0,3,10,0"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FF334155"
                                                           VerticalAlignment="Top"
                                                           Text="本车核心边界红线" />
                                                <ItemsControl ItemsSource="{Binding WelcomeDashboard.RedlineItems}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,2,8,2"
                                                                    Padding="8,2.5"
                                                                    CornerRadius="6"
                                                                    Background="White"
                                                                    BorderBrush="#FFE2E8F0"
                                                                    BorderThickness="1">
                                                                <TextBlock FontSize="11.5"
                                                                           Foreground="#FF475569"
                                                                           Text="{Binding}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 2. 2×2 场景化工程任务卡片 -->
                                <TextBlock Margin="4,16,0,9"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#FF64748B"
                                           Text="选择典型工程场景直接开始，或在下方输入您的设计意图：" />

                                <ItemsControl ItemsSource="{Binding WelcomeDashboard.ScenarioCards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:WelcomeScenarioCardItem}">
                                            <Button Margin="0,0,10,10"
                                                    Style="{StaticResource ScenarioTaskCardButtonStyle}"
                                                    Command="{Binding DataContext.SendQuickPromptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Prompt}">
                                                <StackPanel>
                                                    <Border HorizontalAlignment="Left"
                                                            Padding="8,2.5"
                                                            CornerRadius="6"
                                                            Background="{Binding TagBackgroundHex}">
                                                        <TextBlock FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding TagForegroundHex}"
                                                                   Text="{Binding Tag}" />
                                                    </Border>
                                                    <TextBlock Margin="0,8,0,4"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FF0F172A"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Title}" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="#FF64748B"
                                                               LineHeight="18"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Description}" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               FontSize="11.5"
                                                               FontWeight="Medium"
                                                               Foreground="#FF0284C7"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding ActionCue}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 正常多轮对话消息流（用户发送首条消息或点击场景卡片后显示） -->
                            <ItemsControl x:Name="ChatItemsControl"
                                          Visibility="{Binding ShowChatMessageStream, Converter={StaticResource BoolToVis}}"
                                          ItemsSource="{Binding ChatMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ChatMessage}">
                                        <Border x:Name="Bubble"
                                                Margin="0,0,56,14"
                                                Padding="15,12"
                                                Background="#FFF8FAFC"
                                                BorderBrush="#FFE2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="14,14,14,4"
                                                HorizontalAlignment="Left">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <Button x:Name="CopyBubbleButton"
                                                            DockPanel.Dock="Right"
                                                            Style="{StaticResource BubbleCopyButtonStyle}"
                                                            Content="复制"
                                                            Opacity="0"
                                                            ToolTip="复制此条回复内容"
                                                            Click="CopyBubbleButton_Click" />

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border x:Name="RoleAvatar"
                                                                Width="20"
                                                                Height="20"
                                                                Margin="0,0,7,0"
                                                                Background="#FFE0F2FE"
                                                                CornerRadius="10">
                                                            <TextBlock x:Name="RoleAvatarText"
                                                                       Text="AI"
                                                                       FontSize="9.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="#FF0284C7"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock x:Name="RoleHeaderText"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FF334155"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding RoleDisplay}" />
                                                        <TextBlock Margin="8,0,0,0"
                                                                   FontSize="11.5"
                                                                   Foreground="#FF94A3B8"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding TimeDisplay}" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- 普通 AI 回复：接入格式化富文本排版（支持加粗/列表/代码/公式） -->
                                                <ui:RagFormattedText x:Name="FormattedAiReply"
                                                                     Markup="{Binding Text}"
                                                                     HideSourceReferences="False" />

                                                <!-- 用户消息：保持原样清晰只读文本 -->
                                                <TextBox x:Name="UserPlainText"
                                                         Style="{StaticResource BorderlessTextBoxStyle}"
                                                         Visibility="Collapsed"
                                                         IsReadOnly="True"
                                                         FontSize="14"
                                                         Foreground="#FF0F172A"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding Text}" />

                                                <!-- RAG 规范问答回复：完整保留引用与可展开资料片段 -->
                                                <ContentControl x:Name="RagReply"
                                                                Content="{Binding}"
                                                                Visibility="Collapsed">
                                                    <ContentControl.ContentTemplate>
                                                        <DataTemplate>
                                                            <ui:RagReplyView />
                                                        </DataTemplate>
                                                    </ContentControl.ContentTemplate>
                                                </ContentControl>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RoleDisplay}" Value="AI">
                                                <Setter TargetName="RoleHeaderText" Property="Text" Value="智能设计助手" />
                                            </DataTrigger>
                                            <Trigger SourceName="Bubble" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CopyBubbleButton" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsLocalKnowledgeReply}" Value="True">
                                                <Setter TargetName="FormattedAiReply" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="UserPlainText" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="RagReply" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                                <Setter TargetName="Bubble" Property="Margin" Value="56,0,0,14" />
                                                <Setter TargetName="Bubble" Property="Background" Value="#FFE0F2FE" />
                                                <Setter TargetName="Bubble" Property="BorderBrush" Value="#FFBAE6FD" />
                                                <Setter TargetName="Bubble" Property="CornerRadius" Value="14,14,4,14" />
                                                <Setter TargetName="RoleAvatar" Property="Background" Value="#FF0284C7" />
                                                <Setter TargetName="RoleAvatarText" Property="Text" Value="您" />
                                                <Setter TargetName="RoleAvatarText" Property="Foreground" Value="White" />
                                                <Setter TargetName="RoleHeaderText" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="FormattedAiReply" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="UserPlainText" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="CopyBubbleButton" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                </Border>
            </Grid>

            <!-- Row 2：瞬态状态区（仅在处理中或有待确认改模时短暂出现，平时 0 高度） -->
            <StackPanel Grid.Row="2" Visibility="{Binding HasActiveProject, Converter={StaticResource BoolToVis}}">
                <!-- A. AI 思考中 / CAD 处理中轻量提示条 -->
                <Border Margin="0,0,0,8"
                        Padding="12,8"
                        Background="#FFF0F9FF"
                        BorderBrush="#FFBAE6FD"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{Binding IsAssistantBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource DangerSoftButtonStyle}"
                                    Content="停止等待"
                                    Command="{Binding CancelChatCommand}"
                                    Visibility="{Binding IsChatBusy, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#FF0284C7" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock FontSize="12.5"
                                           Foreground="#FF0369A1"
                                           FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding BusyBannerText}" />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Margin="0,7,0,0"
                                     Height="3"
                                     IsIndeterminate="True"
                                     BorderThickness="0"
                                     Background="#FFE0F2FE"
                                     Foreground="#FF0284C7" />
                    </StackPanel>
                </Border>

                <!-- B. 待确认修改快捷条（确认或取消后立刻消失，平时不占地） -->
                <Border Margin="0,0,0,8"
                        Padding="13,9"
                        Background="#FFFFFBEB"
                        BorderBrush="#FFFCD34D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{Binding HasPendingCadConfirmation, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Style="{StaticResource SuccessButtonStyle}"
                                    Content="✓ 确认执行改模"
                                    Command="{Binding ConfirmBusinessCommand}" />
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource DangerSoftButtonStyle}"
                                    Content="✕ 取消"
                                    Command="{Binding CancelPendingBusinessCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Padding="6,2" Margin="0,0,8,0" Background="#FFFEF3C7" CornerRadius="5">
                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="#FFB45309" Text="待确认修改" />
                            </Border>
                            <TextBlock FontSize="12.5"
                                       Foreground="#FF78350F"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding PendingCadConfirmationSummary}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Row 3：一体式现代圆角输入卡片（仅在存在活动项目时展示） -->
            <Border Grid.Row="3"
                    Padding="12,10,12,10"
                    Background="White"
                    BorderThickness="1.2"
                    CornerRadius="14"
                    Visibility="{Binding HasActiveProject, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#FFD8E2EC" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#FF38BDF8" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 多行输入文本框（Enter 发送，Shift+Enter 换行） -->
                    <Grid Grid.Row="0" MinHeight="64" MaxHeight="150">
                        <TextBox x:Name="UserInputTextBox"
                                 Style="{StaticResource BorderlessTextBoxStyle}"
                                 Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="64"
                                 Padding="6,4"
                                 FontSize="14"
                                 PreviewKeyDown="UserInputTextBox_PreviewKeyDown" />
                        <TextBlock Margin="8,5,16,4"
                                   Foreground="#FF94A3B8"
                                   FontSize="13.5"
                                   IsHitTestVisible="False"
                                   Text="输入结构咨询、当前尺寸查询、轻量化目标或修改指令（如：现在尺寸是多少？ / 把上弦杆改成 60x60 / 壁厚改成 4）"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text.IsEmpty, ElementName=UserInputTextBox}" Value="True" />
                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=UserInputTextBox}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- 底部精简工具栏 + 发送主按钮 -->
                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Margin="0,0,12,0"
                                       FontSize="11.5"
                                       Foreground="#FF94A3B8"
                                       VerticalAlignment="Center"
                                       Text="Enter 发送 · Shift+Enter 换行" />
                            <Button MinWidth="92"
                                    Height="36"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{Binding PrimaryActionText}"
                                    Command="{Binding PrimaryActionCommand}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Height="30"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Content="重新解析"
                                    Command="{Binding ReparseCommand}" />
                            <Button Height="30"
                                    Margin="4,0,0,0"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Content="清空本轮消息"
                                    ToolTip="仅清空当前这一条对话内的消息记录，不影响项目快照与其他对话"
                                    Click="ClearConversationButton_Click" />
                            <Button Height="30"
                                    Margin="4,0,0,0"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Content="{Binding AdvancedDebugButtonText}"
                                    Command="{Binding ToggleAdvancedDebugCommand}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Row 4：高级调试（完整保留全部 4 个页签） -->
            <Expander Grid.Row="4"
                      Margin="0,10,0,0"
                      IsExpanded="{Binding IsAdvancedDebugExpanded, Mode=TwoWay}"
                      Header="高级调试">
                <Border Padding="12"
                        Background="White"
                        BorderBrush="#FFE2E8F0"
                        BorderThickness="1"
                        CornerRadius="0,0,12,12">
                    <TabControl x:Name="AdvancedDebugTabControl"
                                MinHeight="240">
                        <TabItem Header="JSON 结果">
                            <TextBox Text="{Binding JsonOutput, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Padding="10" />
                        </TabItem>
                        <TabItem Header="参数表">
                            <DataGrid ItemsSource="{Binding Parameters}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="参数名" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="显示名" Binding="{Binding DisplayName}" Width="2*" />
                                    <DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="*" />
                                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="*" />
                                    <DataGridTextColumn Header="映射状态" Binding="{Binding MappingStatus}" Width="1.4*" />
                                    <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="APDL 预览">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top"
                                            Orientation="Horizontal"
                                            Margin="12">
                                    <Button Width="160"
                                            Height="32"
                                            Content="生成 APDL 调试文件"
                                            Command="{Binding GenerateApdlCommand}" />
                                    <Button Width="140"
                                            Height="32"
                                            Margin="10,0,0,0"
                                            Content="打开输出文件"
                                            Command="{Binding OpenApdlOutputFileCommand}" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Margin="12,0,12,8"
                                           Text="{Binding ApdlOutputPath}" />
                                <TextBox Margin="12"
                                         Text="{Binding ApdlPreviewContent, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Padding="10" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="日志输出">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0"
                                           Margin="0,0,0,10"
                                           LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Left"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <CheckBox x:Name="LogAutoScrollCheckBox"
                                                  Margin="0,0,16,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsLogAutoScrollEnabled, Mode=TwoWay}"
                                                  Checked="LogAutoScrollCheckBox_Checked"
                                                  Content="自动滚动到底部" />
                                        <Button Width="100"
                                                Height="30"
                                                Margin="0,0,8,0"
                                                Content="滚动到底部"
                                                Click="ScrollLogToBottomButton_Click" />
                                        <Button Width="92"
                                                Height="30"
                                                Margin="0,0,8,0"
                                                Content="清空显示"
                                                Command="{Binding ClearLogsCommand}" />
                                        <Button Width="108"
                                                Height="30"
                                                Margin="0,0,8,0"
                                                Content="复制当前日志"
                                                Command="{Binding CopyCurrentLogsCommand}" />
                                        <Button Width="116"
                                                Height="30"
                                                Margin="0,0,8,0"
                                                Content="测试 LLM 连接"
                                                Command="{Binding TestLlmConnectionCommand}" />
                                        <Button Width="92"
                                                Height="30"
                                                Margin="0,0,12,0"
                                                Content="导出日志"
                                                ToolTip="弹出保存对话框导出当前对话的 .txt 日志，并同步复制到剪贴板"
                                                Command="{Binding ExportLogsCommand}" />
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               FontSize="11.5"
                                               Foreground="#64748B"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CurrentLogScopeSummary}"
                                               Text="{Binding CurrentLogScopeSummary}" />
                                </DockPanel>

                                <TextBox x:Name="LogTextBox"
                                         Grid.Row="1"
                                         Text="{Binding Logs, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Padding="10"
                                         TextChanged="LogTextBox_TextChanged" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Expander>
        </Grid>
    </Grid>
</Window>
