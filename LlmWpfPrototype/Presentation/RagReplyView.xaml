<UserControl x:Class="LlmWpfPrototype.Presentation.RagReplyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:LlmWpfPrototype.Presentation"
             Focusable="False"
             HorizontalContentAlignment="Stretch">
    <UserControl.Resources>
        <ui:RagCitationLabelConverter x:Key="CitationLabel" />
        <ui:RagCitationStatusConverter x:Key="CitationStatus" />
    </UserControl.Resources>
    <StackPanel TextElement.FontSize="14" TextElement.Foreground="#FF0F172A">
        <ui:RagFormattedText Markup="{Binding Text}" Citations="{Binding LocalSources}"
                               HideSourceReferences="True" />
        <TextBlock Margin="0,8,0,0"
                   Foreground="#FF475569"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Text="{Binding LocalCitationStatus, Converter={StaticResource CitationStatus}, Mode=OneWay}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Margin="0,12,0,0" Padding="12,10"
                BorderBrush="#FFD8E5F0" BorderThickness="1"
                Background="#FFF2F7FC" CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LocalSources.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="本轮资料" FontWeight="SemiBold" Foreground="#FF173A58" />
                <TextBlock Margin="0,4,0,6"
                           FontSize="12" Foreground="#FF475569" TextWrapping="Wrap"
                           Text="正文中的「依据 1」等编号对应下方同号资料。所列片段尚未核验其对当前设计的适用性。" />
                <ItemsControl ItemsSource="{Binding LocalSources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4,0,0" Padding="8,5" Background="White"
                                    BorderBrush="#FFE0EAF3" BorderThickness="1" CornerRadius="6">
                                <Expander Header="{Binding}">
                                    <Expander.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Id, Converter={StaticResource CitationLabel}}"
                                                           Foreground="#FF0F5A99" FontWeight="SemiBold" />
                                                <TextBlock Text=" · " Foreground="#FF64748B" />
                                                <TextBlock Text="{Binding Source.Title}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Expander.HeaderTemplate>
                                    <StackPanel Margin="0,8,0,2">
                                        <ui:RagFormattedText Markup="{Binding SentText}" Margin="0,6,0,6"
                                                             MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                                             HideSourceReferences="True" />
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
